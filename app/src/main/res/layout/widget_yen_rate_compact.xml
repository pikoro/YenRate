<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <!-- Currency Pair Label -->
    <TextView
        android:id="@+id/text_compact_pair_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/usd_jpy_pair"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Rate Change Arrow Indicator -->
    <ImageView
        android:id="@+id/image_compact_arrow"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="@string/rate_change_indicator"
        android:src="@drawable/ic_arrow_neutral" />

    <!-- Compact Exchange Rate Column Display -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_compact_exchange_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¥ ---.--"
            android:textColor="#F8FAFC"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_compact_real_exchange_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFD600"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
